package templates

templ Settings(apiKey, model string) {
	@Layout("Settings") {
		<div class="flex h-screen">
			<aside class="w-64 bg-gray-900 border-r border-gray-800 flex flex-col p-4 gap-4">
				<div class="text-red-500 font-bold text-xl tracking-widest">THREATLENS</div>
				<nav class="flex flex-col gap-2">
                    <a href="/settings" class="text-gray-300 hover:text-red-400 text-sm">Settings</a>
					<a href="/" class="text-gray-300 hover:text-red-400 text-sm">Dashboard</a>
					<a href="/history" class="text-gray-300 hover:text-red-400 text-sm">History</a>
					<a href="/settings" class="text-red-400 text-sm">Settings</a>
				</nav>
			</aside>
			<main class="flex-1 p-8">
				<h1 class="text-xl font-bold text-gray-100 mb-6">Settings</h1>
				<form hx-post="/settings" hx-swap="none" class="flex flex-col gap-4 max-w-lg">
					<div class="flex flex-col gap-1">
						<label class="text-sm text-gray-400">API Key</label>
						<input
							type="password"
							name="api_key"
							value={ apiKey }
							placeholder="sk-or-... or leave empty for local"
							class="bg-gray-800 border border-gray-700 rounded px-3 py-2 text-sm text-gray-100 placeholder-gray-600 focus:outline-none focus:border-red-500"/>
					</div>
					<div class="flex flex-col gap-1">
						<label class="text-sm text-gray-400">Model</label>
						<input
							type="text"
							name="model"
							value={ model }
							placeholder="google/gemma-4-31b-it:free or qwen3:latest"
							class="bg-gray-800 border border-gray-700 rounded px-3 py-2 text-sm text-gray-100 placeholder-gray-600 focus:outline-none focus:border-red-500"/>
					</div>
					<button
						type="submit"
						class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded text-sm w-fit">
						Save
					</button>
					<div id="save-status" class="text-sm text-green-400 hidden">Saved.</div>
				</form>
			</main>
		</div>
	}
}